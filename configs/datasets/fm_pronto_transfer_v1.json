{
  "schema_version": 1,
  "id": "pronto_continuous_imputation_transfer_v1",
  "source_config": "configs/datasets/pronto_public.json",
  "kind": "csv_series",
  "separator": ",",
  "features": ["AirIn", "Air.T", "Air.P", "WaterIn", "Water.T", "Water.Density", "Mixture.zone.P", "riser.outlet.P", "P.topsep", "FR.topsep.gas", "FR.topsep.liquid", "P_3phase", "Air.Valve", "Water.level", "Water.coalescer", "Water.level.valve", "water.tank.level"],
  "window_length": 48,
  "window_stride": 48,
  "split_policy": "ordered_whole_files",
  "ordered_split_names": ["train", "val", "test"],
  "split_seed": 2026,
  "mask_seeds": [2026, 2027, 2028, 2029, 2030],
  "missing_ratios": [0.1, 0.5, 0.9],
  "missing_patterns": ["point", "block", "channel"],
  "output_root": "data/public_datasets/flow_matching/processed_campaign_v1/pronto_transfer",
  "boundary": "New continuous-process imputation benchmark: Testday2 train, Testday3 validation, Testday4 test. The 12 alarm-state columns and Fault label are excluded. Three days do not support strong cross-plant generalization claims.",
  "citation": "https://doi.org/10.5281/zenodo.1341583"
}
