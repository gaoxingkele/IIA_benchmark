{
  "schema_version": 1,
  "id": "skab_continuous_imputation_transfer_v1",
  "source_config": "configs/datasets/skab_public.json",
  "kind": "csv_series",
  "separator": ";",
  "features": ["Accelerometer1RMS", "Accelerometer2RMS", "Current", "Pressure", "Temperature", "Thermocouple", "Voltage", "Volume Flow RateRMS"],
  "window_length": 48,
  "window_stride": 48,
  "split_policy": "whole_file_groups",
  "split_seed": 2026,
  "mask_seeds": [2026, 2027, 2028, 2029, 2030],
  "missing_ratios": [0.1, 0.5, 0.9],
  "missing_patterns": ["point", "block", "channel"],
  "output_root": "data/public_datasets/flow_matching/processed_campaign_v1/skab_transfer",
  "boundary": "New continuous-sensor imputation benchmark. Native anomaly/changepoint labels and datetime are excluded from model inputs. Whole files are split before windowing.",
  "citation": "https://doi.org/10.1007/s41060-022-00355-4"
}
